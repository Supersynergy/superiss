#!/usr/bin/env bash
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  if [[ "$LINK" = /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
case "${SIS_IMPL:-ts}" in
  rs|py) exec "$ROOT/bin/sis-reference" "$@" ;;
  ts) ;;
  *) printf '%s\n' 'SIS_IMPL must be ts, rs or py' >&2; exit 2 ;;
esac
case "${1:-}" in
  reference) shift; exec "$ROOT/bin/sis-reference" "$@" ;;
  forge) shift; exec "${SIS_BUN:-bun}" "$ROOT/sisf/sisf.ts" "$@" ;;
  up|down|status) exec "${SIS_BUN:-bun}" "$ROOT/tools/v1-lifecycle.ts" "$ROOT/bin/sis" "$@" ;;
  service|run) printf '%s\n' 'The macOS local-zero service belongs to the retained reference runtime: sis reference service|run ...' >&2; exit 2 ;;
esac
exec "${SIS_BUN:-bun}" "$ROOT/packages/superiss/cli.ts" "$@"
